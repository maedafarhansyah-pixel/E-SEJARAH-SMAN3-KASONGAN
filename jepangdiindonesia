function bukaKunci() {
    var password = prompt("Masukkan kata sandi untuk membuka kunci jawaban:");
    if (password === null) return;
    if (password === "1234567890") {
        document.getElementById('kunciLockBox').style.display = 'none';
        document.getElementById('kunciJawaban').classList.add('revealed');
        alert("✅ Kata sandi benar! Kunci jawaban berhasil dibuka.");
    } else {
        alert("❌ Kata sandi salah! Akses ditolak.");
    }
}

(function() {
    var answers = {};
    document.querySelectorAll('.soal-pg, .soal-tf').forEach(function(q, idx) {
        var type = q.getAttribute('data-soal');
        var qid = type + '-' + idx;
        var spans = q.querySelectorAll('.opsi span');
        spans.forEach(function(s) {
            s.addEventListener('click', function(e) {
                e.stopPropagation();
                if (answers[qid] !== undefined) return;
                var isCorrect = s.getAttribute('data-answer') === 'true';
                answers[qid] = isCorrect;
                if (isCorrect) s.classList.add('correct');
                else {
                    s.classList.add('wrong');
                    spans.forEach(function(x) {
                        if (x.getAttribute('data-answer') === 'true') x.classList.add('correct');
                    });
                }
            });
        });
    });

    window.hitungSkor = function() {
        var pgTotal = document.querySelectorAll('.soal-pg').length;
        var tfTotal = document.querySelectorAll('.soal-tf').length;
        var total = pgTotal + tfTotal;
        var answered = Object.keys(answers).length;
        if (answered === 0) { alert('Klik terlebih dahulu pada opsi jawaban untuk menjawab soal!'); return; }
        var benar = 0, salah = 0;
        for (var k in answers) { if (answers[k]) benar++; else salah++; }
        var skor = Math.round((benar / total) * 100);
        var predikat = skor >= 90 ? 'A (Sangat Baik)' : skor >= 80 ? 'B (Baik)' : skor >= 70 ? 'C (Cukup)' : skor >= 60 ? 'D (Perlu Bimbingan)' : 'E (Remedial)';
        document.getElementById('spBenar').textContent = benar;
        document.getElementById('spSalah').textContent = salah;
        document.getElementById('spSkor').textContent = skor;
        document.getElementById('spPredikat').textContent = predikat;
        if (answered < total) {
            setTimeout(function() {
                alert('Kamu baru menjawab ' + answered + ' dari ' + total + ' soal.\nSkor sementara: ' + skor);
            }, 100);
        }
    };

    window.resetSkor = function() {
        answers = {};
        document.querySelectorAll('.soal-pg .opsi span, .soal-tf .opsi span').forEach(function(s) {
            s.classList.remove('correct','wrong');
        });
        document.getElementById('spBenar').textContent = '0';
        document.getElementById('spSalah').textContent = '0';
        document.getElementById('spSkor').textContent = '0';
        document.getElementById('spPredikat').textContent = '-';
    };
})();

