<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
<meta name="theme-color" content="#141008" />
<meta name="description" content="Modul Ajar Deep Learning Sejarah Kelas X Fase E — Pendudukan Jepang di Indonesia. SMAN 3 Kasongan." />
<title>HistoExplorer — Pendudukan Jepang · Kelas X / Fase E · SMAN 3 Kasongan</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>
/* ============================================================
   HISTOEXPLORER — PENDUDUKAN JEPANG
   Palet: Kuning Emas · Amber · Oranye Hangat
   ============================================================ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}

:root{
  --primary:#F4C430;--primary-light:#FFE47A;--primary-dark:#B8860B;
  --accent:#E67E22;--accent-rgb:230,126,34;
  --gold:#FFD700;--gold-rgb:255,215,0;
  --emerald:#F39C12;--em-lt:#F5B041;
  --violet:#D68910;--sky:#F7DC6F;--rose:#E74C3C;

  --bg:#141008;--bg-soft:#1c1709;--card-bg:#241e0e;--card-alt:#2e2712;
  --text:#fdf9e8;--text-light:#d4c99a;--text-muted:#9a8e5e;
  --line:rgba(255,228,122,.12);--line-soft:rgba(255,228,122,.07);

  --shadow:0 10px 34px rgba(0,0,0,.55);
  --shadow-hover:0 20px 56px rgba(0,0,0,.70);
  --shadow-sm:0 4px 16px rgba(0,0,0,.45);
  --radius:22px;--radius-sm:14px;--radius-xs:10px;
  --transition:.38s cubic-bezier(.34,1.56,.64,1);
  --ease:.35s cubic-bezier(.22,1,.36,1);
  --header-h:64px;
}
body.light-mode{
  --bg:#fdf8e8;--bg-soft:#ffffff;--card-bg:#ffffff;--card-alt:#faf0d0;
  --text:#2a2208;--text-light:#5a4a18;--text-muted:#8a7a3a;
  --line:rgba(42,34,8,.10);--line-soft:rgba(42,34,8,.055);
  --shadow:0 10px 34px rgba(60,45,10,.10);
  --shadow-hover:0 20px 56px rgba(60,45,10,.18);
  --shadow-sm:0 4px 16px rgba(60,45,10,.06);
}

html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);line-height:1.75;overflow-x:hidden;min-height:100vh;transition:background .4s ease,color .4s ease}
h1,h2,h3,h4,h5{font-family:'Plus Jakarta Sans','Inter',sans-serif;line-height:1.25}
img{max-width:100%;display:block}
a{color:var(--primary-light);text-decoration:none}
strong{color:var(--text);font-weight:700}
em{font-style:italic}
::selection{background:var(--primary);color:#141008}

/* BACKGROUND */
.geo-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.6;
  background-image:radial-gradient(circle at 15% 12%,rgba(244,196,48,.18) 0%,transparent 55%),
    radial-gradient(circle at 85% 80%,rgba(230,126,34,.14) 0%,transparent 52%),
    radial-gradient(circle at 50% 50%,rgba(255,215,0,.08) 0%,transparent 60%);}
.geo-bg::after{content:"";position:absolute;inset:0;
  background-image:repeating-linear-gradient(45deg,transparent,transparent 46px,rgba(255,228,122,.035) 46px,rgba(255,228,122,.035) 47px),
    repeating-linear-gradient(-45deg,transparent,transparent 46px,rgba(244,196,48,.030) 46px,rgba(244,196,48,.030) 47px);
  background-size:92px 92px,92px 92px;}

/* LOADER */
#loader{position:fixed;inset:0;background:rgba(20,16,8,.97);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:99999;
  transition:opacity .7s ease,visibility .7s ease;padding:20px;text-align:center}
body.light-mode #loader{background:rgba(253,248,232,.97)}
#loader.hidden{opacity:0;visibility:hidden;pointer-events:none}
.loader-geo{width:100px;height:100px;position:relative;animation:spinGeo 3.2s ease-in-out infinite}
.loader-geo svg{width:100%;height:100%;display:block;filter:drop-shadow(0 8px 20px rgba(244,196,48,.40))}
.loader-ring-big{position:absolute;top:-28px;left:-28px;width:156px;height:156px;border-radius:50%;border:5px solid transparent;
  border-top-color:var(--accent);border-right-color:var(--primary-light);border-bottom-color:var(--gold);border-left-color:var(--primary);
  animation:spinRing 3s linear infinite;box-shadow:0 0 34px rgba(244,196,48,.30)}
.loader-ring-big::after{content:'';position:absolute;inset:12px;border-radius:50%;border:3px dashed rgba(255,228,122,.28);animation:spinRing 8s linear infinite reverse}
@keyframes spinRing{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}
@keyframes spinGeo{0%,100%{transform:rotate(0) scale(1)}50%{transform:rotate(180deg) scale(1.06)}}
.loader-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2.1rem,6vw,3.6rem);font-weight:900;margin-top:28px;
  background:linear-gradient(135deg,var(--primary),var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;letter-spacing:-1.5px;line-height:1.1;background-size:220% auto;animation:shimmerText 3s ease-in-out infinite}
@keyframes shimmerText{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.loader-sub{font-size:clamp(.86rem,1.6vw,1.05rem);font-weight:500;color:var(--text-light);margin-top:8px;letter-spacing:.5px;font-style:italic;
  background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;animation:pulseSub 2.4s ease-in-out infinite}
@keyframes pulseSub{0%,100%{opacity:.85;transform:scale(1)}50%{opacity:1;transform:scale(1.02)}}
.loader-bar-track{width:clamp(220px,45vw,420px);height:6px;background:rgba(244,196,48,.14);border-radius:10px;margin-top:28px;overflow:hidden}
.loader-bar{height:100%;width:0;border-radius:10px;background:linear-gradient(90deg,var(--primary),var(--accent),var(--gold));transition:width .3s ease}
.loader-percent{color:var(--text-muted);font-size:.7rem;font-weight:700;margin-top:10px;letter-spacing:1.5px;font-variant-numeric:tabular-nums}

/* HEADER */
.site-header{position:fixed;top:0;left:0;right:0;height:var(--header-h);
  background:rgba(20,16,8,.92);backdrop-filter:blur(22px) saturate(160%);-webkit-backdrop-filter:blur(22px) saturate(160%);
  border-bottom:1px solid var(--line-soft);z-index:1000;display:flex;align-items:center;justify-content:space-between;
  padding:0 clamp(12px,2.4vw,28px);gap:10px;transition:box-shadow .3s ease,background .4s ease}
body.light-mode .site-header{background:rgba(255,255,255,.92)}
.site-header.scrolled{box-shadow:0 6px 30px rgba(0,0,0,.35)}
.site-header .brand{display:flex;align-items:center;gap:10px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
  font-size:clamp(1rem,2.2vw,1.2rem);color:var(--primary-light);text-decoration:none;letter-spacing:-.4px;flex-shrink:0;cursor:pointer}
.site-header .brand .logo-dot{width:36px;height:36px;border-radius:11px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;font-size:1rem;
  box-shadow:0 6px 18px rgba(244,196,48,.42);transition:transform var(--transition)}
.site-header .brand:hover .logo-dot{transform:rotate(-10deg) scale(1.08)}
.site-header .nav-links{display:flex;align-items:center;gap:2px;list-style:none;flex-wrap:nowrap;overflow:hidden;flex:1;justify-content:center}
.site-header .nav-links a{display:inline-block;padding:6px 10px;border-radius:30px;font-size:.68rem;font-weight:600;
  color:var(--text-light);text-decoration:none;transition:all .28s ease;cursor:pointer;white-space:nowrap}
.site-header .nav-links a:hover{background:rgba(244,196,48,.14);color:var(--primary-light)}
.site-header .nav-links a.active{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;box-shadow:0 4px 14px rgba(244,196,48,.40)}
.site-header .header-actions{display:flex;align-items:center;gap:6px;flex-shrink:0}
.site-header .icon-btn{width:38px;height:38px;border-radius:12px;border:1px solid var(--line);
  background:var(--card-bg);color:var(--primary-light);cursor:pointer;display:grid;place-items:center;font-size:.92rem;transition:all var(--ease)}
.site-header .icon-btn:hover{background:var(--primary);color:#141008;border-color:var(--primary);transform:translateY(-2px)}
.site-header .menu-toggle{display:none;width:38px;height:38px;border-radius:12px;border:1px solid var(--line);
  background:var(--card-bg);font-size:1rem;color:var(--primary-light);cursor:pointer;align-items:center;justify-content:center;flex-shrink:0}

/* PROGRESS RAIL */
.progress-rail{position:fixed;top:var(--header-h);left:0;right:0;height:3px;background:rgba(244,196,48,.10);z-index:999}
.progress-rail .thumb{height:100%;width:0;background:linear-gradient(90deg,var(--primary),var(--accent),var(--gold));
  transition:width .6s cubic-bezier(.34,1.56,.64,1);border-radius:0 3px 3px 0;box-shadow:0 0 12px rgba(244,196,48,.60)}

/* DRAWER */
.mobile-drawer{position:fixed;top:0;right:-360px;width:min(330px,88vw);height:100%;background:var(--card-bg);z-index:1002;
  padding:22px 18px;box-shadow:-10px 0 50px rgba(0,0,0,.5);transition:right .5s cubic-bezier(.34,1.56,.64,1);
  overflow-y:auto;overscroll-behavior:contain}
.mobile-drawer.open{right:0}
.mobile-drawer .close-btn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--bg-soft);
  font-size:1.1rem;color:var(--text);cursor:pointer;margin-bottom:18px;display:grid;place-items:center;margin-left:auto;transition:all var(--transition)}
.mobile-drawer .close-btn:hover{background:var(--primary);color:#141008}
.mobile-drawer .dw-head{font-size:.7rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--text-muted);margin:0 4px 10px}
.mobile-drawer a{display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:14px;font-weight:600;font-size:.9rem;
  color:var(--text-light);text-decoration:none;transition:all .3s ease;cursor:pointer;margin-bottom:4px}
.mobile-drawer a:hover,.mobile-drawer a.active{background:rgba(244,196,48,.14);color:var(--primary-light)}
.mobile-drawer a.active{background:linear-gradient(135deg,rgba(244,196,48,.20),rgba(230,126,34,.12));font-weight:700}
.drawer-overlay{position:fixed;inset:0;background:rgba(10,8,4,.55);backdrop-filter:blur(3px);z-index:1001;opacity:0;visibility:hidden;transition:all .4s ease}
.drawer-overlay.open{opacity:1;visibility:visible}

/* LAYOUT */
.main-wrap{position:relative;z-index:1;padding-top:calc(var(--header-h) + 26px);max-width:1180px;margin:0 auto;
  padding-left:clamp(14px,3.5vw,48px);padding-right:clamp(14px,3.5vw,48px);padding-bottom:70px}
.section{display:none;animation:fadeUp .7s cubic-bezier(.34,1.56,.64,1) forwards;padding:6px 0 20px}
.section.active{display:block}
@keyframes fadeUp{0%{opacity:0;transform:translateY(34px) scale(.985)}100%{opacity:1;transform:translateY(0) scale(1)}}

/* SECTION HEADER */
.section-header{display:flex;align-items:flex-start;gap:14px;margin-bottom:26px;padding-bottom:16px;
  border-bottom:2px solid var(--line-soft);flex-wrap:wrap;position:relative}
.section-header::after{content:'';position:absolute;bottom:-2px;left:0;width:96px;height:2px;
  background:linear-gradient(90deg,var(--primary),var(--accent),var(--gold));border-radius:2px}
.section-header .num{display:flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:16px;
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;font-family:'Plus Jakarta Sans',sans-serif;
  font-weight:800;font-size:1.05rem;flex-shrink:0;box-shadow:0 10px 26px rgba(244,196,48,.42);transform:rotate(-4deg)}
.section-header h2{font-size:clamp(1.2rem,2.9vw,1.85rem);font-weight:800;color:var(--text);letter-spacing:-.5px;flex:1;min-width:180px}
.section-header h2 small{display:block;font-weight:400;font-size:.82rem;color:var(--text-muted);margin-top:3px;letter-spacing:0}
.section-header .badge{background:rgba(244,196,48,.12);color:var(--primary-light);padding:5px 16px;border-radius:40px;
  font-size:.7rem;font-weight:700;letter-spacing:.5px;border:1px solid var(--line);white-space:nowrap;align-self:center}
.section-header .badge.badge-time{background:rgba(230,126,34,.14);color:var(--accent);border-color:rgba(230,126,34,.22)}
.section-header .badge.badge-asesmen{background:rgba(255,215,0,.14);color:var(--gold);border-color:rgba(255,215,0,.24)}

/* BANNER */
.pertemuan-banner{display:flex;align-items:center;gap:16px;
  background:linear-gradient(135deg,rgba(244,196,48,.09),rgba(230,126,34,.05));
  border-left:5px solid var(--primary);border-radius:var(--radius-sm);padding:16px 20px;margin-bottom:20px;
  flex-wrap:wrap;box-shadow:var(--shadow-sm)}
.pertemuan-banner .icon-wrap{width:48px;height:48px;border-radius:15px;background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#141008;display:flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;box-shadow:0 8px 20px rgba(244,196,48,.38)}
.pertemuan-banner .info{flex:1;min-width:190px}
.pertemuan-banner .info h4{font-size:.95rem;font-weight:800;color:var(--text);margin:0 0 3px;letter-spacing:.2px}
.pertemuan-banner .info p{font-size:.84rem;color:var(--text-muted);margin:0;line-height:1.55}
.pertemuan-banner .time-chip{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--accent),var(--primary));
  color:#141008;font-size:.74rem;font-weight:700;padding:7px 15px;border-radius:30px;white-space:nowrap;box-shadow:0 6px 18px rgba(230,126,34,.38)}

/* ESSENTIAL / TUJUAN / CP */
.essential-box{background:linear-gradient(135deg,rgba(214,137,16,.10),rgba(244,196,48,.05));
  border-left:5px solid var(--violet);border-radius:var(--radius-sm);padding:18px 22px;margin-bottom:20px;box-shadow:0 8px 24px rgba(214,137,16,.12)}
.essential-box .es-title{display:flex;align-items:center;gap:10px;color:var(--violet);font-size:.88rem;font-weight:800;
  margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}
.essential-box .es-title i{background:linear-gradient(135deg,var(--violet),#E8B852);color:#141008;width:30px;height:30px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.82rem}
.essential-box ul{list-style:none;padding:0;margin:0}
.essential-box ul li{position:relative;padding:7px 0 7px 26px;color:var(--text-light);font-size:.9rem;line-height:1.7;font-style:italic}
.essential-box ul li::before{content:'❓';position:absolute;left:0;top:7px;font-size:.85rem}

.tujuan-box{background:linear-gradient(135deg,rgba(255,215,0,.10),rgba(244,196,48,.04));
  border-left:5px solid var(--gold);border-radius:var(--radius-sm);padding:20px 24px;margin-bottom:22px;box-shadow:0 8px 28px rgba(255,215,0,.14)}
.tujuan-box .tujuan-title{display:flex;align-items:center;gap:10px;color:var(--gold);font-size:.92rem;font-weight:800;
  margin-bottom:6px;text-transform:uppercase;letter-spacing:1px}
.tujuan-box .tujuan-title i{background:linear-gradient(135deg,var(--gold),var(--accent));color:#141008;width:30px;height:30px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.82rem;box-shadow:0 4px 14px rgba(255,215,0,.40)}
.tujuan-box .tujuan-desc{font-size:.84rem;color:var(--text-muted);font-style:italic;margin-bottom:12px}
.tujuan-box ol{list-style:none;padding:0;margin:0;counter-reset:tujuan-counter}
.tujuan-box ol li{counter-increment:tujuan-counter;position:relative;padding:10px 0 10px 44px;color:var(--text-light);
  font-size:.9rem;line-height:1.68;border-bottom:1px dashed rgba(255,215,0,.26)}
.tujuan-box ol li:last-child{border-bottom:none;padding-bottom:4px}
.tujuan-box ol li::before{content:counter(tujuan-counter);position:absolute;left:0;top:10px;width:27px;height:27px;
  background:linear-gradient(135deg,var(--gold),var(--accent));color:#141008;border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.76rem;box-shadow:0 4px 12px rgba(255,215,0,.40)}

.cp-box{background:linear-gradient(135deg,rgba(230,126,34,.08),rgba(244,196,48,.04));
  border-left:5px solid var(--em-lt);border-radius:var(--radius-sm);padding:20px 24px;margin-bottom:22px}
.cp-box .cp-title{display:flex;align-items:center;gap:10px;color:var(--em-lt);font-size:.92rem;font-weight:800;
  margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.cp-box .cp-title i{background:var(--em-lt);color:#141008;width:30px;height:30px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.82rem}
.cp-box p{font-size:.9rem;color:var(--text-light);line-height:1.75;margin-bottom:8px}

/* DPL FOCUS GRID */
.dpl-focus-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:28px 0}
.dpl-focus-item{background:linear-gradient(145deg,var(--card-bg),var(--card-alt));
  border:1px solid var(--line);border-radius:var(--radius);padding:26px 20px;text-align:center;
  transition:all var(--ease);position:relative;overflow:hidden}
.dpl-focus-item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--primary),var(--accent));opacity:.7;transition:opacity var(--ease)}
.dpl-focus-item:hover{transform:translateY(-5px);box-shadow:var(--shadow-hover);border-color:var(--primary)}
.dpl-focus-item:hover::before{opacity:1}
.dpl-focus-item .focus-icon{font-size:2.4rem;display:block;margin-bottom:14px;line-height:1}
.dpl-focus-item .focus-label{font-size:.66rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;
  color:var(--gold);display:block;margin-bottom:8px}
.dpl-focus-item .focus-title{font-size:.98rem;font-weight:800;color:var(--text);margin-bottom:8px;
  font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.2px}
.dpl-focus-item .focus-desc{font-size:.83rem;color:var(--text-light);line-height:1.65}
@media (max-width:640px){ .dpl-focus-grid{grid-template-columns:1fr;} }

/* FORMATIF */
.formatif-box{background:linear-gradient(135deg,rgba(230,126,34,.07),rgba(244,196,48,.04));
  border-left:5px solid var(--accent);border-radius:var(--radius-sm);padding:20px 24px;margin-bottom:22px}
.formatif-box .formatif-title{display:flex;align-items:center;gap:10px;color:var(--accent);font-size:.92rem;font-weight:800;
  margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.formatif-box .formatif-title i{background:linear-gradient(135deg,var(--accent),var(--primary));color:#141008;width:30px;height:30px;
  border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.82rem}
.formatif-kuis{background:var(--card-bg);border-radius:var(--radius-xs);padding:15px 17px;margin-bottom:12px;border:1px solid rgba(230,126,34,.18)}
.formatif-kuis .kuis-label{font-size:.68rem;font-weight:800;color:var(--accent);text-transform:uppercase;letter-spacing:1.1px;margin-bottom:6px}
.formatif-kuis .kuis-pertanyaan{font-size:.9rem;font-weight:600;color:var(--text);margin-bottom:10px;line-height:1.6}
.formatif-kuis .kuis-opsi{display:flex;flex-wrap:wrap;gap:7px}
.formatif-kuis .kuis-opsi span{display:inline-block;background:rgba(244,196,48,.08);border:1.5px solid var(--line);
  border-radius:22px;padding:6px 16px;font-size:.79rem;color:var(--text-light);cursor:pointer;transition:all .28s ease;font-weight:600}
.formatif-kuis .kuis-opsi span:hover{background:rgba(244,196,48,.16);border-color:var(--primary);transform:translateY(-2px)}
.formatif-kuis .kuis-opsi span.correct{background:rgba(230,126,34,.26);border-color:var(--accent);color:#fff5e0;box-shadow:0 4px 14px rgba(230,126,34,.30)}
body.light-mode .formatif-kuis .kuis-opsi span.correct{color:#4a2a00}
.formatif-kuis .kuis-opsi span.wrong{background:rgba(231,76,60,.18);border-color:var(--rose);color:#ffd6dd}
body.light-mode .formatif-kuis .kuis-opsi span.wrong{color:#7a1029}
.formatif-refleksi{background:var(--card-alt);border-radius:var(--radius-xs);padding:13px 17px;border:1px dashed rgba(230,126,34,.32)}
.formatif-refleksi .refleksi-label{font-size:.68rem;font-weight:800;color:var(--gold);text-transform:uppercase;letter-spacing:1.1px;margin-bottom:4px}
.formatif-refleksi p{font-size:.87rem;color:var(--text-light);line-height:1.7;font-style:italic}

/* PENGAYAAN / PENDALAMAN */
.pengayaan-box{background:linear-gradient(135deg,rgba(214,137,16,.10),rgba(255,215,0,.05));
  border-left:5px solid var(--violet);border-radius:var(--radius-sm);padding:20px 24px;margin-bottom:22px}
.pengayaan-box .pengayaan-title{display:flex;align-items:center;gap:10px;color:var(--violet);font-size:.92rem;font-weight:800;
  margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.pengayaan-box .pengayaan-title i{background:var(--violet);color:#141008;width:30px;height:30px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.82rem}
.pengayaan-box .pengayaan-desc{font-size:.84rem;color:var(--text-muted);font-style:italic;margin-bottom:12px}
.pengayaan-item{background:var(--card-bg);border-radius:var(--radius-xs);padding:15px 17px;margin-bottom:10px;
  border:1px solid rgba(214,137,16,.20);transition:all var(--ease)}
.pengayaan-item:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.pengayaan-item h5{font-size:.89rem;font-weight:800;color:var(--violet);margin-bottom:7px;display:flex;align-items:center;gap:8px}
.pengayaan-item h5 i{font-size:.92rem}
.pengayaan-item p,.pengayaan-item li{font-size:.87rem;color:var(--text-light);line-height:1.72}
.pengayaan-item ul,.pengayaan-item ol{padding-left:20px;margin-top:4px}

.pendalaman-box{background:linear-gradient(135deg,rgba(230,126,34,.08),rgba(244,196,48,.04));
  border-left:5px solid var(--em-lt);border-radius:var(--radius-sm);padding:20px 24px;margin-bottom:22px}
.pendalaman-box .pendalaman-title{display:flex;align-items:center;gap:10px;color:var(--em-lt);font-size:.92rem;font-weight:800;
  margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.pendalaman-box .pendalaman-title i{background:var(--em-lt);color:#141008;width:30px;height:30px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.82rem}
.pendalaman-box .pendalaman-desc{font-size:.84rem;color:var(--text-muted);font-style:italic;margin-bottom:12px}
.pendalaman-item{background:var(--card-bg);border-radius:var(--radius-xs);padding:15px 17px;margin-bottom:10px;
  border:1px solid rgba(230,126,34,.20);transition:all var(--ease)}
.pendalaman-item:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.pendalaman-item h5{font-size:.89rem;font-weight:800;color:var(--em-lt);margin-bottom:7px;display:flex;align-items:center;gap:8px}
.pendalaman-item h5 i{font-size:.92rem}
.pendalaman-item p,.pendalaman-item li{font-size:.87rem;color:var(--text-light);line-height:1.72}
.pendalaman-item ul,.pendalaman-item ol{padding-left:20px;margin-top:4px}

/* DEEP */
.deep-box{background:linear-gradient(135deg,rgba(244,196,48,.06),rgba(255,215,0,.04));
  border:1px solid var(--line);border-radius:var(--radius-sm);padding:20px 22px;margin:22px 0;position:relative;overflow:hidden}
.deep-box::before{content:'DEEP LEARNING';position:absolute;top:0;right:0;background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#141008;font-size:.58rem;font-weight:800;letter-spacing:1.4px;padding:5px 14px;border-radius:0 0 0 12px}
.deep-box h4{font-size:.98rem;font-weight:800;color:var(--primary-light);margin-bottom:14px;display:flex;align-items:center;gap:9px}
.deep-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.deep-item{background:var(--card-bg);border-radius:12px;padding:14px 16px;border-left:4px solid var(--primary);transition:all var(--ease)}
.deep-item:hover{transform:translateY(-3px);box-shadow:var(--shadow-sm)}
.deep-item .di-tag{font-size:.62rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--primary-light);display:block;margin-bottom:5px}
.deep-item .di-text{font-size:.84rem;color:var(--text-light);line-height:1.65}
.deep-item:nth-child(1){border-left-color:var(--sky)} .deep-item:nth-child(1) .di-tag{color:var(--sky)}
.deep-item:nth-child(2){border-left-color:var(--gold)} .deep-item:nth-child(2) .di-tag{color:var(--gold)}
.deep-item:nth-child(3){border-left-color:var(--em-lt)} .deep-item:nth-child(3) .di-tag{color:var(--em-lt)}
.deep-item:nth-child(4){border-left-color:var(--violet)} .deep-item:nth-child(4) .di-tag{color:var(--violet)}

/* MISKONSEPSI */
.miskonsepsi-card{background:linear-gradient(135deg,rgba(231,76,60,.07),rgba(255,215,0,.04));
  border:1px solid rgba(231,76,60,.22);border-radius:var(--radius-xs);padding:15px 18px;margin:12px 0}
.miskonsepsi-card .miskon-label{display:inline-block;background:var(--rose);color:#141008;font-size:.64rem;font-weight:800;
  padding:3px 11px;border-radius:20px;letter-spacing:.5px;margin-bottom:9px;text-transform:uppercase}
.miskonsepsi-card .miskon-label.info{background:var(--accent);color:#141008}
.miskonsepsi-card p{font-size:.87rem;color:var(--text-light);line-height:1.72}

/* SUB HEADER */
.sub-header{display:flex;align-items:center;gap:11px;margin:26px 0 12px;padding:8px 0;
  font-family:'Plus Jakarta Sans',sans-serif;font-size:1.02rem;font-weight:800;color:var(--primary-light);
  border-bottom:1px dashed rgba(244,196,48,.28)}
.sub-header .tag-letter{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:10px;
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;font-size:.75rem;font-weight:900;flex-shrink:0;
  box-shadow:0 4px 12px rgba(244,196,48,.35)}

/* CARD */
.card{background:var(--card-bg);border-radius:var(--radius);padding:24px 26px;box-shadow:var(--shadow);
  transition:all var(--transition);border:1px solid var(--line-soft);margin-bottom:16px}
.card:hover{box-shadow:var(--shadow-hover);transform:translateY(-4px)}
.card h3{font-size:1.08rem;font-weight:700;color:var(--text);margin-bottom:4px}
.card h4{font-size:.95rem;font-weight:600;color:var(--text-light)}
.card p,.card li{font-size:.93rem;color:var(--text-light);line-height:1.8}
.card ul{padding-left:20px;margin:6px 0}
.card ul li{list-style-type:disc}
.card-enhanced{background:linear-gradient(145deg,var(--card-bg),var(--card-alt));border:1px solid var(--line-soft)}

.grid-2,.grid-3,.grid-4{display:grid;gap:16px;margin:12px 0 8px;grid-template-columns:1fr}

/* HERO — MINIMAL BERANDA */
.hero-section{text-align:center;padding:36px 0 44px}
.hero-section .logo-row{display:flex;justify-content:center;align-items:center;gap:clamp(16px,4vw,48px);flex-wrap:wrap;margin-bottom:30px}
.hero-section .logo-row img{height:clamp(58px,9vw,96px);width:auto;object-fit:contain;
  filter:drop-shadow(0 6px 22px rgba(244,196,48,.22));transition:transform .5s ease}
.hero-section .logo-row img:hover{transform:scale(1.05)}

.hero-section .badge-row{display:flex;justify-content:center;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:26px}
.hero-section .badge-row .tag{background:rgba(244,196,48,.12);color:var(--primary-light);font-size:.68rem;font-weight:700;
  padding:5px 18px;border-radius:40px;letter-spacing:.6px;border:1px solid var(--line);text-transform:uppercase}
.hero-section .badge-row .tag.gold{background:rgba(255,215,0,.15);color:var(--gold);border-color:rgba(255,215,0,.24)}
.hero-section .badge-row .tag.green{background:rgba(230,126,34,.12);color:var(--em-lt);border-color:rgba(230,126,34,.20)}

.hero-title{font-size:clamp(2rem,6.5vw,4.4rem);font-weight:900;letter-spacing:-2px;line-height:1.05;color:var(--text);margin:0 0 18px}
.hero-title .highlight{background:linear-gradient(135deg,var(--primary),var(--accent),var(--gold));-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;background-size:200% auto;animation:shimmerText 5s ease-in-out infinite}

.hero-sub{font-size:clamp(.95rem,1.5vw,1.1rem);color:var(--text-light);max-width:600px;margin:0 auto;font-weight:400;line-height:1.85}
.hero-sub strong{color:var(--text);font-weight:700}

.hero-school{margin-top:32px}
.hero-school .name{display:inline-block;background:var(--card-bg);padding:11px 34px;border-radius:60px;
  font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(1.05rem,2.4vw,1.6rem);
  box-shadow:var(--shadow);border:1px solid var(--line-soft);color:var(--primary-light);letter-spacing:-.5px}
.hero-school .name .gold{color:var(--gold)}
.hero-school .teacher{margin-top:12px;font-size:.95rem;font-weight:500;color:var(--text-light);
  background:rgba(244,196,48,.06);display:inline-block;padding:8px 24px;border-radius:40px;border:1px solid var(--line-soft);line-height:1.9}
.hero-school .teacher strong{color:var(--primary-light);font-weight:800;font-size:1rem;letter-spacing:.3px}
.hero-school .teacher .nip{color:var(--accent);font-weight:700;font-size:.9rem;background:rgba(230,126,34,.12);
  padding:3px 14px;border-radius:30px;letter-spacing:.5px}

.hero-cta{margin:34px 0 16px;display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.hero-cta .btn-primary{display:inline-flex;align-items:center;gap:14px;
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;border:none;
  padding:clamp(14px,2vw,18px) clamp(30px,5vw,52px);border-radius:60px;font-family:inherit;font-weight:700;
  font-size:clamp(.95rem,1.4vw,1.05rem);cursor:pointer;transition:all var(--transition);
  box-shadow:0 10px 34px rgba(244,196,48,.40);text-decoration:none}
.hero-cta .btn-primary:hover{transform:translateY(-4px) scale(1.03);box-shadow:0 18px 50px rgba(244,196,48,.50)}
.hero-cta .btn-primary i{transition:transform .3s ease}
.hero-cta .btn-primary:hover i{transform:translateX(5px)}
.hero-cta .btn-ghost{display:inline-flex;align-items:center;gap:10px;background:transparent;color:var(--primary-light);
  border:2px solid var(--line);padding:clamp(12px,1.8vw,16px) clamp(24px,4vw,36px);border-radius:60px;
  font-family:inherit;font-weight:700;font-size:clamp(.88rem,1.2vw,.98rem);cursor:pointer;transition:all var(--transition)}
.hero-cta .btn-ghost:hover{background:rgba(244,196,48,.10);border-color:var(--primary);transform:translateY(-3px)}

/* QUICK NAV */
.quick-nav{background:transparent;border-radius:var(--radius);padding:0;margin-top:52px;border:none}
.quick-nav .nav-title{display:flex;align-items:center;gap:12px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;
  font-size:1rem;color:var(--text-muted);padding-bottom:16px;margin-bottom:24px;justify-content:center;letter-spacing:2px;text-transform:uppercase}
.quick-nav .nav-title i{color:var(--gold);font-size:1.15rem}
.quick-nav .nav-title::before,.quick-nav .nav-title::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);max-width:140px}
.quick-nav .nav-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
.quick-nav .nav-item{position:relative;overflow:hidden;cursor:pointer;border-radius:16px;padding:24px 16px 20px;min-height:128px;
  text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#141008;font-weight:800;border:none;
  box-shadow:0 10px 26px rgba(0,0,0,.28);transition:all .4s cubic-bezier(.34,1.56,.64,1);isolation:isolate}
.quick-nav .nav-item::before{content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 30% 0%, rgba(255,255,255,.28) 0%, transparent 60%);pointer-events:none;z-index:1}
.quick-nav .nav-item .label{position:relative;z-index:2;font-weight:900;color:#141008;letter-spacing:.4px;font-size:.98rem;line-height:1.2;text-shadow:0 1px 3px rgba(255,255,255,.20)}
.quick-nav .nav-item .sub-label{font-size:.68rem;font-weight:700;color:rgba(20,16,8,.72);position:relative;z-index:2;letter-spacing:.4px}
.quick-nav .nav-item .num{position:absolute;top:10px;right:12px;font-size:.62rem;font-weight:900;letter-spacing:1.2px;color:#141008;
  background:rgba(255,255,255,.38);padding:3px 9px;border-radius:30px;border:1px solid rgba(255,255,255,.32);z-index:2}
.quick-nav .nav-item:nth-child(odd){background:linear-gradient(140deg,#B8860B 0%,#F4C430 100%);}
.quick-nav .nav-item:nth-child(even){background:linear-gradient(140deg,#E67E22 0%,#F7DC6F 100%);}
.quick-nav .nav-item:nth-child(odd) .label,
.quick-nav .nav-item:nth-child(odd) .sub-label,
.quick-nav .nav-item:nth-child(odd) .num{color:#ffffff}
.quick-nav .nav-item:nth-child(odd) .label{text-shadow:0 1px 3px rgba(0,0,0,.30)}
.quick-nav .nav-item:nth-child(odd) .sub-label{color:rgba(255,255,255,.85)}
.quick-nav .nav-item:nth-child(odd) .num{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.28);color:#ffffff}
.quick-nav .nav-item:hover{transform:translateY(-7px) scale(1.02);box-shadow:0 20px 44px rgba(244,196,48,.42);filter:brightness(1.10)}
.quick-nav .nav-item:active{transform:translateY(-2px) scale(.98);transition:all .1s ease}

/* MATERI ACCORDION */
.materi-box{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;
  border:1px solid var(--line-soft);margin-bottom:14px;transition:box-shadow var(--ease),border-color var(--ease)}
.materi-box:hover{box-shadow:var(--shadow-hover)}
.materi-box .header{padding:17px 20px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:12px;
  transition:background .3s ease;border-left:4px solid transparent;user-select:none}
.materi-box .header:hover{background:rgba(244,196,48,.06)}
.materi-box .header.active{border-left-color:var(--primary);background:linear-gradient(90deg,rgba(244,196,48,.08),transparent)}
.materi-box .header h4{font-size:.94rem;font-weight:700;color:var(--text);margin:0;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.materi-box .header h4 .tag-sm{font-size:.6rem;font-weight:700;background:rgba(244,196,48,.12);color:var(--primary-light);
  padding:2px 12px;border-radius:20px;letter-spacing:.3px}
.materi-box .header .icon{transition:transform .5s cubic-bezier(.34,1.56,.64,1);color:var(--text-muted);font-size:.85rem;flex-shrink:0;
  width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--bg-soft)}
.materi-box .header.active .icon{transform:rotate(180deg);color:#141008;background:linear-gradient(135deg,var(--primary),var(--accent))}
.materi-box .body{max-height:0;overflow:hidden;
  transition:max-height .6s cubic-bezier(.22,1,.36,1),padding .5s cubic-bezier(.22,1,.36,1),opacity .4s ease .05s;
  padding:0 20px;opacity:0;border-top:1px solid transparent}
.materi-box .body.open{max-height:18000px;padding:18px 20px 22px;opacity:1;border-top-color:var(--line-soft)}

/* HIGHLIGHT BOX */
.highlight-box{background:rgba(244,196,48,.06);border-radius:var(--radius-xs);padding:15px 18px;
  border-left:4px solid var(--primary);margin:8px 0 12px}
.highlight-box p{font-size:.93rem;color:var(--text-light);line-height:1.8}
.highlight-box strong{color:var(--text);font-weight:700}

/* TABEL */
.table-wrap{overflow-x:auto;margin:10px 0;border-radius:var(--radius-xs);-webkit-overflow-scrolling:touch;border:1px solid var(--line-soft)}
.table-wrap table{width:100%;border-collapse:collapse;font-size:.87rem;background:var(--card-bg);min-width:420px}
.table-wrap th,.table-wrap td{padding:11px 15px;border-bottom:1px solid var(--line-soft);text-align:left;vertical-align:top;line-height:1.65}
.table-wrap th{background:rgba(244,196,48,.10);color:var(--primary-light);font-weight:700;white-space:nowrap}
.table-wrap td{color:var(--text-light)}
.table-wrap tr:last-child td{border-bottom:none}
.table-wrap tbody tr{transition:background .25s ease}
.table-wrap tbody tr:hover{background:rgba(244,196,48,.05)}

/* INTERACTIVE CARD */
.interactive-card{cursor:pointer;transition:all var(--transition);background:linear-gradient(145deg,var(--card-bg),var(--card-alt));
  border:1px solid var(--line);border-radius:var(--radius);padding:18px 17px;box-shadow:var(--shadow-sm)}
.interactive-card:hover{border-color:var(--accent);transform:translateY(-4px);box-shadow:var(--shadow-hover)}
.interactive-card.open{background:linear-gradient(145deg,rgba(244,196,48,.10),rgba(230,126,34,.06));border-color:var(--primary)}
.interactive-card .back{display:none;padding-top:12px;border-top:2px dashed rgba(244,196,48,.36);margin-top:12px;font-size:.9rem}
.interactive-card.open .back{display:block;animation:fadeUp .45s ease}
.interactive-card .toggle-hint{font-size:.68rem;margin-top:9px;display:inline-flex;align-items:center;gap:5px;font-weight:700;
  letter-spacing:.4px;color:var(--primary-light);background:rgba(244,196,48,.14);padding:4px 12px;border-radius:20px}
.interactive-card .back p{color:var(--text-light);font-size:.88rem;line-height:1.72;margin-bottom:6px}
.interactive-card .back ul{padding-left:18px;margin:6px 0}
.interactive-card .back ul li{color:var(--text-light);font-size:.87rem;line-height:1.7;margin-bottom:3px}
.interactive-card .back strong{color:var(--text)}
.pillar-icon{font-size:2.1rem;display:block;margin-bottom:6px}

/* CONCEPT MAP */
.concept-map{background:linear-gradient(145deg,rgba(244,196,48,.07),rgba(230,126,34,.04));
  border-radius:var(--radius);padding:26px 22px;margin:24px 0;border:1px solid var(--line);overflow-x:auto}
.cm-center{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;text-align:center;
  padding:16px 26px;border-radius:16px;font-weight:900;font-size:1.02rem;letter-spacing:.5px;max-width:360px;margin:0 auto;
  box-shadow:0 12px 30px rgba(244,196,48,.40);position:relative;font-family:'Plus Jakarta Sans',sans-serif}
.cm-center small{display:block;font-weight:600;font-size:.72rem;opacity:.85;margin-top:3px;letter-spacing:.3px}
.cm-center::after{content:'';position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);width:2px;height:18px;background:var(--line)}
.cm-branches{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:34px}
.cm-branch{background:var(--card-bg);border-radius:14px;padding:16px 14px;border-top:4px solid var(--gold);text-align:center;
  transition:all var(--ease);box-shadow:var(--shadow-sm)}
.cm-branch:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
.cm-branch h5{font-size:.86rem;font-weight:800;color:var(--primary-light);margin-bottom:5px}
.cm-branch p{font-size:.78rem;color:var(--text-muted);line-height:1.55}
.cm-branch:nth-child(1){border-top-color:var(--primary)}
.cm-branch:nth-child(2){border-top-color:var(--accent)}
.cm-branch:nth-child(3){border-top-color:var(--em-lt)}
.cm-branch:nth-child(4){border-top-color:var(--violet)}
.cm-branch:nth-child(5){border-top-color:var(--gold)}

/* GLOSARIUM */
.glossary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin:14px 0}
.glossary-item{background:var(--card-bg);border-radius:12px;padding:13px 16px;border-left:4px solid var(--accent);
  transition:all var(--ease);box-shadow:var(--shadow-sm)}
.glossary-item:hover{transform:translateX(4px);box-shadow:var(--shadow)}
.glossary-item .gl-term{font-size:.88rem;font-weight:800;color:var(--primary-light);margin-bottom:3px;display:flex;align-items:center;gap:6px}
.glossary-item .gl-term i{font-size:.7rem;opacity:.65}
.glossary-item .gl-def{font-size:.82rem;color:var(--text-light);line-height:1.6}

/* LKPD */
.lkpd-box{background:linear-gradient(145deg,rgba(230,126,34,.08),rgba(214,137,16,.05));
  border:2px solid rgba(230,126,34,.24);border-radius:var(--radius);padding:22px 24px;margin:18px 0}
.lkpd-box .lkpd-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.lkpd-box .lkpd-head .lkpd-icon{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#141008;display:grid;place-items:center;font-size:1.1rem;box-shadow:0 8px 20px rgba(244,196,48,.38)}
.lkpd-box .lkpd-head h4{font-size:1rem;font-weight:800;color:var(--primary-light);margin:0}
.lkpd-box .lkpd-head span{font-size:.76rem;color:var(--text-muted);display:block;font-weight:400}
.lkpd-box .lkpd-body{background:var(--card-bg);border-radius:12px;padding:16px 18px;border:1px dashed rgba(230,126,34,.32)}
.lkpd-box .lkpd-body p{font-size:.87rem;color:var(--text-light);line-height:1.75;margin-bottom:6px}
.lkpd-write{display:block;border:none;border-bottom:1.5px dashed rgba(230,126,34,.42);background:transparent;width:100%;
  padding:8px 4px;margin:6px 0 14px;font-family:inherit;font-size:.88rem;color:var(--text);outline:none;transition:border-color .3s ease}
.lkpd-write:focus{border-bottom-color:var(--accent);border-bottom-style:solid}
.lkpd-write::placeholder{color:var(--text-muted);font-style:italic;font-size:.82rem}

/* SOAL */
.soal-pg{margin-bottom:12px;padding:15px 18px;background:rgba(244,196,48,.045);border-radius:var(--radius-xs);
  border-left:4px solid var(--primary);transition:all .3s ease}
.soal-pg:hover{background:rgba(244,196,48,.08);transform:translateX(3px)}
.soal-pg .nomor{color:var(--primary-light);font-weight:800;font-size:.85rem;margin-right:6px}
.soal-pg .pertanyaan{color:var(--text);font-weight:600;font-size:.93rem;margin-bottom:6px;line-height:1.65}
.soal-pg .opsi{display:grid;grid-template-columns:1fr 1fr;gap:2px 20px;padding-left:0}
.soal-pg .opsi span{font-size:.87rem;color:var(--text-light);line-height:2;cursor:pointer;padding:2px 8px;border-radius:8px;
  transition:all .25s ease;display:inline-block}
.soal-pg .opsi span:hover{background:rgba(244,196,48,.10)}
.soal-pg .opsi span.correct{background:rgba(230,126,34,.26);color:#fff5e0;font-weight:700}
body.light-mode .soal-pg .opsi span.correct{color:#4a2a00}
.soal-pg .opsi span.wrong{background:rgba(231,76,60,.20);color:#ffd0d8;font-weight:700}
body.light-mode .soal-pg .opsi span.wrong{color:#7a1029}
.soal-tf{margin-bottom:12px;padding:15px 18px;background:rgba(214,137,16,.06);border-radius:var(--radius-xs);
  border-left:4px solid var(--violet);transition:all .3s ease}
.soal-tf:hover{background:rgba(214,137,16,.10);transform:translateX(3px)}
.soal-tf .nomor{color:var(--violet);font-weight:800;font-size:.85rem;margin-right:6px}
.soal-tf .pertanyaan{color:var(--text);font-weight:600;font-size:.93rem;margin-bottom:5px;line-height:1.65}
.soal-tf .opsi{padding-left:0}
.soal-tf .opsi span{font-size:.84rem;color:var(--text-light);margin-right:8px;font-weight:700;display:inline-block;
  background:rgba(214,137,16,.12);padding:4px 16px;border-radius:20px;cursor:pointer;transition:all .25s ease}
.soal-tf .opsi span:hover{transform:translateY(-2px)}
.soal-tf .opsi span.correct{background:rgba(230,126,34,.26);color:#fff5e0}
body.light-mode .soal-tf .opsi span.correct{color:#4a2a00}
.soal-tf .opsi span.wrong{background:rgba(231,76,60,.20);color:#ffd0d8}
body.light-mode .soal-tf .opsi span.wrong{color:#7a1029}
.soal-essay{margin-bottom:12px;padding:15px 18px;background:rgba(255,215,0,.07);border-radius:var(--radius-xs);
  border-left:4px solid var(--gold);transition:all .3s ease}
.soal-essay:hover{background:rgba(255,215,0,.12);transform:translateX(3px)}
.soal-essay .nomor{color:var(--gold);font-weight:800;font-size:.85rem;margin-right:6px}
.soal-essay .pertanyaan{color:var(--text);font-weight:600;font-size:.93rem;margin-bottom:5px;line-height:1.7}

/* SCORE PANEL */
.score-panel{position:sticky;bottom:14px;z-index:50;background:linear-gradient(135deg,var(--card-bg),var(--card-alt));
  border:2px solid var(--line);border-radius:var(--radius);padding:14px 20px;margin:20px 0;
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;box-shadow:0 14px 40px rgba(0,0,0,.45)}
.score-panel .sp-info{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.score-panel .sp-stat{text-align:center}
.score-panel .sp-stat .sp-val{font-family:'Plus Jakarta Sans',sans-serif;font-size:1.5rem;font-weight:900;color:var(--primary-light);line-height:1}
.score-panel .sp-stat .sp-lbl{font-size:.62rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px}
.score-panel .sp-btn{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;border:none;
  padding:11px 24px;border-radius:40px;font-family:inherit;font-weight:700;font-size:.85rem;cursor:pointer;
  display:inline-flex;align-items:center;gap:8px;transition:all var(--transition);box-shadow:0 8px 22px rgba(244,196,48,.38)}
.score-panel .sp-btn:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(244,196,48,.48)}
.score-panel .sp-btn.reset{background:linear-gradient(135deg,var(--text-muted),#7a6a3a);color:#fff;box-shadow:none}

/* KUNCI */
.kunci-lock-box{background:linear-gradient(135deg,rgba(231,76,60,.08),rgba(255,215,0,.06));
  border:2px dashed rgba(231,76,60,.32);border-radius:var(--radius-sm);padding:28px 24px;text-align:center;margin:20px 0}
.kunci-lock-box .lock-icon{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--rose),var(--gold));
  color:#141008;font-size:1.5rem;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;
  box-shadow:0 10px 28px rgba(231,76,60,.32);animation:pulseLock 2.6s ease-in-out infinite}
@keyframes pulseLock{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
.kunci-lock-box h4{font-size:1.05rem;font-weight:800;color:var(--text);margin-bottom:5px}
.kunci-lock-box p{font-size:.87rem;color:var(--text-muted);margin-bottom:16px}
.kunci-btn{display:inline-flex;align-items:center;gap:9px;background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#141008;border:none;padding:13px 30px;border-radius:40px;font-family:inherit;font-weight:700;font-size:.9rem;
  cursor:pointer;transition:all var(--transition);box-shadow:0 8px 24px rgba(244,196,48,.38)}
.kunci-btn:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(244,196,48,.48)}
.kunci-box{display:none;background:linear-gradient(135deg,rgba(230,126,34,.08),rgba(244,196,48,.05));
  border-left:5px solid var(--accent);border-radius:var(--radius-sm);padding:24px 26px;margin:20px 0}
.kunci-box.revealed{display:block;animation:fadeUp .5s ease}
.kunci-box .kunci-title{display:flex;align-items:center;gap:10px;color:var(--em-lt);font-size:1rem;font-weight:800;
  margin-bottom:16px;text-transform:uppercase;letter-spacing:1px}
.kunci-box .kunci-title i{background:var(--em-lt);color:#141008;width:32px;height:32px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;font-size:.9rem}
.kunci-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(72px,1fr));gap:8px;margin-bottom:18px}
.kunci-grid .kunci-item{background:var(--card-bg);border:1px solid rgba(230,126,34,.28);border-radius:10px;padding:9px 6px;
  text-align:center;font-weight:700;color:var(--text);font-size:.84rem}
.kunci-grid .kunci-item .num{display:block;font-size:.64rem;color:var(--text-muted);font-weight:600;margin-bottom:2px}
.kunci-grid .kunci-item .ans{color:var(--em-lt);font-weight:900;font-size:.9rem}
body.light-mode .kunci-grid .kunci-item .ans{color:#4a2a00}
.kunci-essay-item{background:var(--card-bg);border-left:4px solid var(--accent);border-radius:10px;padding:14px 17px;margin-bottom:10px}
.kunci-essay-item .essay-num{font-weight:800;color:var(--em-lt);font-size:.85rem;margin-bottom:5px}
body.light-mode .kunci-essay-item .essay-num{color:#4a2a00}
.kunci-essay-item p{font-size:.87rem;color:var(--text-light);line-height:1.75}

/* REFLEKSI */
.refleksi-list{list-style:none;padding:0;margin:8px 0}
.refleksi-list li{display:flex;align-items:flex-start;gap:14px;padding:11px 0;font-size:.95rem;color:var(--text-light);
  border-bottom:1px solid var(--line-soft)}
.refleksi-list li:last-child{border-bottom:none}
.refleksi-list li .check{color:var(--accent);font-weight:700;flex-shrink:0;margin-top:2px}

/* CELEBRATION */
.celebration-box{background:linear-gradient(145deg,rgba(244,196,48,.08),rgba(230,126,34,.06));
  border:2px solid var(--line-soft);border-radius:var(--radius);padding:34px 26px;text-align:center;margin-top:16px}
.celebration-box h3{font-size:1.7rem;font-weight:900;color:var(--primary-light);margin-bottom:8px}
.celebration-box p{font-size:1rem;color:var(--text-light);line-height:1.8}
.celebration-box .next-btn{display:inline-block;background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;
  padding:14px 40px;border-radius:60px;font-weight:700;font-size:.98rem;border:none;margin-top:16px;cursor:pointer;transition:all var(--transition);
  box-shadow:0 10px 28px rgba(244,196,48,.34)}
.celebration-box .next-btn:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(244,196,48,.48)}

/* QUOTE */
.quote-block{background:linear-gradient(145deg,rgba(244,196,48,.07),rgba(230,126,34,.05));
  border-left:6px solid var(--primary);padding:18px 22px;border-radius:12px;margin:14px 0;font-style:italic;
  font-size:1.02rem;color:var(--text-light);line-height:1.8}
.quote-block .author{display:block;margin-top:10px;font-style:normal;font-weight:700;color:var(--primary-light);text-align:right;font-size:.9rem}

/* NAV BUTTONS */
.nav-buttons{display:flex;justify-content:center;align-items:center;margin-top:34px;padding-top:22px;
  border-top:1px solid var(--line-soft);flex-wrap:wrap;gap:12px}
.nav-buttons .group{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;width:100%}
.nav-buttons .group > button{background:var(--card-bg);color:var(--text);border:1px solid var(--line);padding:11px 24px;
  border-radius:40px;font-family:inherit;font-weight:700;font-size:.87rem;cursor:pointer;transition:all var(--transition);
  display:inline-flex;align-items:center;gap:8px;min-width:138px;justify-content:center;box-shadow:var(--shadow-sm)}
.nav-buttons .group > button:hover:not(:disabled){background:var(--primary);color:#141008;border-color:var(--primary);
  transform:translateY(-3px);box-shadow:0 10px 26px rgba(244,196,48,.34)}
.nav-buttons .group > button:disabled{opacity:.3;cursor:not-allowed;transform:none!important}
.nav-buttons .group > button.nav-next{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;
  border-color:transparent;box-shadow:0 8px 22px rgba(244,196,48,.38)}
.nav-buttons .counter{font-weight:600;color:var(--text-muted);font-size:.82rem;padding:0 4px}
.nav-buttons .page-numbers{display:flex;gap:5px;flex-wrap:wrap;justify-content:center}
.nav-buttons .page-numbers a{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;
  border-radius:50%;font-size:.8rem;font-weight:700;color:var(--text-muted);background:transparent;border:1px solid transparent;
  text-decoration:none;transition:all .3s ease;cursor:pointer}
.nav-buttons .page-numbers a:hover{background:rgba(244,196,48,.14);border-color:var(--line);color:var(--text)}
.nav-buttons .page-numbers a.active{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;
  border-color:transparent;box-shadow:0 6px 18px rgba(244,196,48,.38);transform:scale(1.08)}

/* REFERENSI */
.ref-list{list-style:none;padding:0}
.ref-list li{padding:11px 0;border-bottom:1px solid var(--line-soft);font-size:.88rem;display:flex;align-items:baseline;
  gap:12px;color:var(--text-light);transition:all .3s ease;line-height:1.7}
.ref-list li:hover{color:var(--text);padding-left:8px;background:rgba(244,196,48,.05)}
.ref-list li strong{font-weight:700;color:var(--text)}
.ref-list li i{color:var(--primary-light);flex-shrink:0}
.footer-credit{text-align:center;margin-top:26px;padding-top:18px;border-top:1px solid var(--line-soft);
  font-size:.84rem;color:var(--text-muted);line-height:2}
.footer-credit strong{color:var(--text);font-weight:700}
.footer-credit .gold{color:var(--gold);font-weight:700}

/* TOKOH CARD */
.tokoh-card{background:linear-gradient(140deg,var(--card-alt),var(--card-bg));
  border:1px solid var(--line);border-radius:var(--radius);padding:20px 20px;transition:all var(--ease);box-shadow:var(--shadow-sm)}
.tokoh-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-hover);border-color:var(--primary)}
.tokoh-card .kc-head{display:flex;align-items:center;gap:12px;margin-bottom:10px;flex-wrap:wrap}
.tokoh-card .kc-emoji{width:48px;height:48px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;font-size:1.6rem;
  background:linear-gradient(135deg,rgba(244,196,48,.20),rgba(230,126,34,.14));
  border:1px solid var(--line)}
.tokoh-card h4{font-size:1.05rem;color:var(--text);margin-bottom:2px}
.tokoh-card .kc-era{font-size:.74rem;color:var(--em-lt);letter-spacing:.06em;font-weight:700}
.tokoh-card .kc-body{font-size:.87rem;color:var(--text-light);line-height:1.7}
.tokoh-card .kc-body p{margin-bottom:5px}

/* REVEAL */
.reveal{opacity:0;transform:translateY(24px);transition:all .7s cubic-bezier(.34,1.56,.64,1)}
.reveal.visible{opacity:1;transform:translateY(0)}

/* TO TOP */
.to-top{position:fixed;right:clamp(14px,2.5vw,28px);bottom:clamp(16px,3vw,32px);width:48px;height:48px;border-radius:16px;
  border:none;background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;font-size:1rem;cursor:pointer;
  z-index:998;display:grid;place-items:center;box-shadow:0 10px 30px rgba(244,196,48,.44);
  opacity:0;visibility:hidden;transform:translateY(20px) scale(.85);transition:all .4s cubic-bezier(.34,1.56,.64,1)}
.to-top.show{opacity:1;visibility:visible;transform:translateY(0) scale(1)}
.to-top:hover{transform:translateY(-4px) scale(1.06);box-shadow:0 16px 40px rgba(244,196,48,.58)}

/* FLOAT NAV */
.float-nav{position:fixed;left:50%;bottom:clamp(16px,2.5vw,26px);transform:translateX(-50%) translateY(24px) scale(.9);
  display:flex;align-items:center;gap:6px;padding:8px;background:rgba(36,30,14,.96);
  backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
  border-radius:60px;box-shadow:0 14px 44px rgba(0,0,0,.55), 0 0 0 1px rgba(244,196,48,.15);
  z-index:997;opacity:0;visibility:hidden;pointer-events:none;transition:all .5s cubic-bezier(.34,1.56,.64,1)}
body.light-mode .float-nav{background:rgba(255,255,255,.96);box-shadow:0 14px 44px rgba(60,45,10,.20), 0 0 0 1px rgba(244,196,48,.20)}
.float-nav.show{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0) scale(1)}
.float-nav button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;font-family:inherit;
  font-weight:700;font-size:.83rem;padding:11px 18px;border-radius:40px;cursor:pointer;transition:all .3s ease;white-space:nowrap;min-height:44px}
.float-nav .fn-prev,.float-nav .fn-next{background:rgba(244,196,48,.14);color:var(--primary-light);border:1px solid rgba(244,196,48,.24);min-width:48px}
.float-nav .fn-prev:hover:not(:disabled),.float-nav .fn-next:hover:not(:disabled){background:var(--primary);color:#141008;border-color:var(--primary);
  transform:translateY(-2px);box-shadow:0 8px 20px rgba(244,196,48,.40)}
.float-nav .fn-home{background:linear-gradient(135deg,var(--primary),var(--accent));color:#141008;
  box-shadow:0 8px 22px rgba(244,196,48,.40);padding:11px 22px;letter-spacing:.2px}
.float-nav .fn-home:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(244,196,48,.55);filter:brightness(1.06)}
.float-nav button:disabled{opacity:.28;cursor:not-allowed;transform:none!important;box-shadow:none}

/* RESPONSIVE */
@media (min-width:600px){
  .grid-2{grid-template-columns:repeat(2,1fr)}
  .grid-3{grid-template-columns:repeat(2,1fr)}
  .grid-4{grid-template-columns:repeat(2,1fr)}
  .quick-nav .nav-grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}
}
@media (min-width:900px){
  .grid-3{grid-template-columns:repeat(3,1fr)}
  .grid-4{grid-template-columns:repeat(4,1fr)}
  .section-header .num{width:56px;height:56px;font-size:1.2rem}
  .section-header h2{font-size:1.85rem}
}
@media (max-width:1050px){
  .site-header .nav-links{display:none}
  .site-header .menu-toggle{display:flex}
}
@media (max-width:768px){
  :root{--header-h:60px}
  .soal-pg .opsi{grid-template-columns:1fr;padding-left:0}
  .main-wrap{padding-bottom:100px}
}
@media (max-width:600px){
  .nav-buttons .group > button{min-width:0;padding:10px 16px;font-size:.8rem}
  .nav-buttons .page-numbers{display:none}
  .hero-school .teacher{font-size:.85rem;padding:7px 16px;display:flex;flex-direction:column;gap:4px;align-items:center}
  .float-nav{gap:4px;padding:6px}
  .float-nav button{padding:10px 13px;font-size:.78rem}
  .float-nav .fn-home{padding:10px 16px}
}
@media (max-width:480px){
  .section-header .num{width:42px;height:42px;font-size:.9rem;border-radius:12px}
  .section-header h2{font-size:1.1rem}
  .card{padding:17px 15px}
  .materi-box .header h4{font-size:.86rem}
  .materi-box .body{padding:0 14px}
  .materi-box .body.open{padding:14px 14px 18px}
  .pertemuan-banner{padding:13px 15px;gap:10px}
  .tujuan-box{padding:16px 16px}
  .tujuan-box ol li{padding-left:38px;font-size:.86rem}
  .hero-title{letter-spacing:-1px}
  .hero-section .logo-row{gap:12px}
  .hero-section .logo-row img{height:clamp(44px,12vw,64px)}
  .quick-nav .nav-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .quick-nav .nav-item{min-height:110px;padding:20px 10px 16px;border-radius:14px}
  .quick-nav .nav-item .label{font-size:.86rem}
  .quick-nav .nav-item .sub-label{font-size:.62rem}
}
@media (min-width:1400px){.main-wrap{max-width:1240px}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
@media print{
  .site-header,.progress-rail,.float-nav,.to-top,.mobile-drawer,.drawer-overlay,
  #loader,.geo-bg,.nav-buttons,.hero-cta,.kunci-lock-box{display:none!important}
  body{background:#fff;color:#000}
  .section{display:block!important;page-break-after:always}
  .materi-box .body{max-height:none!important;opacity:1!important;padding:14px 18px!important}
  .hero-title .highlight{-webkit-text-fill-color:#111;background:none;color:#111}
}
