(function() {
    var sections = document.querySelectorAll('.section');
    var current = 0;
    var total = sections.length;
    var map = {};
    sections.forEach(function(el, i) { map[el.id] = i; });

    function renderNumbers() {
        document.querySelectorAll('.page-numbers').forEach(function(c) {
            var html = '';
            for (var i = 1; i <= total; i++) {
                var active = i === current + 1 ? 'active' : '';
                html += '<a href="#" class="' + active + '" onclick="navigateToPage(' + i + '); return false;">' + i + '</a>';
            }
            c.innerHTML = html;
        });
        document.querySelectorAll('#navLinks a').forEach(function(a, idx) {
            a.classList.toggle('active', idx === current);
        });
        document.querySelectorAll('#mobileDrawer a').forEach(function(a, idx) {
            a.classList.toggle('active', idx === current);
        });
    }

    window.navigateToPage = function(num) {
        var idx = num - 1;
        if (idx >= 0 && idx < total && idx !== current) { current = idx; updateUI(current); }
    };

    window.navigateTo = function(dir) {
        if (dir === 'prev' && current > 0) current--;
        else if (dir === 'next' && current < total - 1) current++;
        else if (typeof dir === 'string' && dir.indexOf('section') === 0) {
            var idx = map[dir];
            if (idx !== undefined && idx !== current) current = idx;
            else return;
        } else return;
        updateUI(current);
    };

    function updateUI(idx) {
        sections.forEach(function(el, i) { el.classList.toggle('active', i === idx); });
        var thumb = document.getElementById('progressThumb');
        if (thumb) thumb.style.width = ((idx + 1) / total * 100) + '%';
        document.querySelectorAll('.counter').forEach(function(el) { el.textContent = (idx+1) + ' / ' + total; });

        document.querySelectorAll('.nav-buttons .group button.nav-next').forEach(function(btn) {
            if (idx === total - 1) { btn.disabled = true; btn.innerHTML = 'Terakhir'; }
            else { btn.disabled = false; btn.innerHTML = 'Selanjutnya <i class="fas fa-arrow-right"></i>'; }
        });
        document.querySelectorAll('.nav-buttons .group button.nav-prev').forEach(function(btn) {
            btn.disabled = idx === 0;
        });

        var floatNav = document.getElementById('floatNav');
        if (floatNav) {
            if (idx >= 1) floatNav.classList.add('show');
            else floatNav.classList.remove('show');
            var fPrev = floatNav.querySelector('.fn-prev');
            var fNext = floatNav.querySelector('.fn-next');
            if (fPrev) fPrev.disabled = (idx === 0);
            if (fNext) fNext.disabled = (idx === total - 1);
        }

        renderNumbers();

        var wrap = document.querySelector('.main-wrap');
        if (wrap) {
            var topPos = wrap.getBoundingClientRect().top + window.pageYOffset - (window.innerWidth < 1000 ? 74 : 86);
            window.scrollTo({ top: topPos, behavior: 'smooth' });
        }
    }

    function initNavButtons() {
        document.querySelectorAll('.nav-buttons').forEach(function(nb) {
            var group = nb.querySelector('.group');
            if (!group) return;
            var prevBtn = group.querySelector('button.nav-prev');
            var nextBtn = group.querySelector('button.nav-next');
            if (prevBtn) prevBtn.addEventListener('click', function() { navigateTo('prev'); });
            if (nextBtn) nextBtn.addEventListener('click', function() { navigateTo('next'); });
        });
    }

    window._histoInit = function() {
        renderNumbers();
        initNavButtons();
        updateUI(0);
    };
})();

function toggleMateri(header) {
    var body = header.nextElementSibling;
    var icon = header.querySelector('.icon i');
    var isOpen = body.classList.contains('open');
    var parent = header.closest('.materi-box');
    var container = parent.parentElement;

    if (!isOpen) {
        container.querySelectorAll('.materi-box .body').forEach(function(b) { b.classList.remove('open'); });
        container.querySelectorAll('.materi-box .header').forEach(function(h) { h.classList.remove('active'); });
        body.classList.add('open');
        header.classList.add('active');
        if (icon) icon.className = 'fas fa-chevron-up';
    } else {
        body.classList.remove('open');
        header.classList.remove('active');
        if (icon) icon.className = 'fas fa-chevron-down';
    }
    container.querySelectorAll('.materi-box .header').forEach(function(h) {
        var i = h.querySelector('.icon i');
        var b = h.nextElementSibling;
        if (b && b.classList.contains('open')) { if (i) i.className = 'fas fa-chevron-up'; }
        else { if (i) i.className = 'fas fa-chevron-down'; }
    });
}

function checkFormatif(container, event) {
    var target = event.target;
    if (target.tagName !== 'SPAN') return;
    var isCorrect = target.getAttribute('data-answer') === 'true';
    var spans = container.querySelectorAll('span');
    spans.forEach(function(s) { s.classList.remove('correct', 'wrong'); });
    if (isCorrect) target.classList.add('correct');
    else target.classList.add('wrong');
}

document.addEventListener('click', function(e) {
    var card = e.target.closest('.interactive-card');
    if (!card) return;
    if (e.target.closest('a, button')) return;
    card.classList.toggle('open');
});
document.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var card = e.target.closest && e.target.closest('.interactive-card');
    if (card && e.target === card) {
        e.preventDefault();
        card.classList.toggle('open');
    }
});

(function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
        reveals.forEach(function(el) { el.classList.add('visible'); });
        return;
    }
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });
})();

document.addEventListener('keydown', function(e) {
    var tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return;
    var drawer = document.getElementById('mobileDrawer');
    if (drawer && drawer.classList.contains('open')) return;
    if (e.key === 'ArrowRight') navigateTo('next');
    else if (e.key === 'ArrowLeft') navigateTo('prev');
});

(function() {
    var x0 = null, y0 = null, locked = false;
    var main = document.querySelector('.main-wrap');
    if (!main) return;

    main.addEventListener('touchstart', function(e) {
        if (e.touches.length !== 1) return;
        if (e.target.closest('.table-wrap') || e.target.closest('.mobile-drawer') || e.target.closest('.float-nav') || e.target.closest('.lkpd-write')) {
            locked = true; return;
        }
        locked = false;
        x0 = e.touches[0].clientX;
        y0 = e.touches[0].clientY;
    }, { passive: true });

    main.addEventListener('touchend', function(e) {
        if (locked || x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        var dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 95 && Math.abs(dy) < 70) {
            if (dx < 0) navigateTo('next');
            else navigateTo('prev');
        }
        x0 = null; y0 = null;
    }, { passive: true });
})();

function bootHisto() {
    if (typeof window._histoInit === 'function') window._histoInit();
}
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootHisto);
} else {
    bootHisto();
}
</script>

